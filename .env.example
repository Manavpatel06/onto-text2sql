# Copy to .env and fill in LLM_API_KEY. Never commit .env.
# ASU Voyager (https://docs.rc.asu.edu/ai/api/): keys under Voyager portal > Profile > Keys.
LLM_BASE_URL=https://openai.rc.asu.edu/v1
LLM_API_KEY=
# Run `ontosql models` to see the models your key can use, then set one here.
LLM_MODEL=qwen38-27b
# For reasoning models: "none" gives short direct answers (recommended for SQL).
LLM_REASONING_EFFORT=none
